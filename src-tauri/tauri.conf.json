{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桂英",
  "identifier": "com.guiying.app",
  "version": "1.0.0",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "bun run fetch:pi",
    "beforeBuildCommand": "bun run fetch:pi && bun run build:extensions"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' mediastream:;",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "minimumWebview2Version": "128.0.0.0"
      }
    },
    "resources": {
      "../public": "public",
      "../extensions/dist": "extensions",
      "./resources/pi": "pi"
    },
    "windows": {
      "nsis": {
        "installWebView2": true
      }
    }
  }
}
